# 운영(prod) 설정 예시. 모든 값은 가짜다(change-me...). 실제 값은 저장소가 아니라 배포 환경의
# 비밀 저장소(서버 환경 변수, systemd EnvironmentFile, 컨테이너 secret 등)에 둔다.
#
# 사용법(예): 서버에서 이 파일을 복사해 채운 뒤 권한을 줄이고(chmod 600) 경로를 지정한다.
#   export JETTAE_ENV_FILE=/etc/jettae/jettae.env
# 실제 프로세스 환경 변수가 파일 값보다 우선한다.
#
# JETTAE_ENV=prod 에서는 시작할 때 아래를 검사하고 하나라도 틀리면 실행하지 않는다:
#   - api, mcp: JETTAE_JWT_SECRET 32바이트 이상, 예시·반복 문자열 아님
#   - api, worker, mcp, db(마이그레이션): JETTAE_DATABASE_URL 이 PostgreSQL
#   - api: JETTAE_ALLOWED_ORIGINS 가 https 출처, JETTAE_COOKIE_SECURE=false 금지
#   - sources ftc/law: JETTAE_DRF_OC 가 본인 OC(test 아님)
#   - JETTAE_LLM_MODE=live 이면 JETTAE_LLM_BUDGET_KRW > 0 이고 JETTAE_LLM_BUDGET_DB 가 PostgreSQL

JETTAE_ENV=prod

# --- 데이터베이스와 파일 저장소(둘을 함께 백업한다: docs/runbook.md 6절)
JETTAE_DATABASE_URL=postgresql+psycopg://jettae:change-me-db-password@db.internal:5432/jettae
JETTAE_BLOB_DIR=/srv/jettae/blobs

# --- 인증. 아래 명령으로 만든 값을 비밀 저장소에 넣는다(이 파일에 실제 값을 남기지 않는다):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JETTAE_JWT_SECRET=change-me-generate-a-random-48-byte-secret
JETTAE_ACCESS_TOKEN_TTL_S=900
JETTAE_REFRESH_TOKEN_TTL_S=1209600
JETTAE_SESSION_MAX_AGE_S=2592000

# --- 브라우저 출처와 쿠키. 화면 주소(https)를 정확히 적는다. '*' 는 거부된다.
JETTAE_ALLOWED_ORIGINS=https://app.example.com
# 비우면 prod 에서 Secure 쿠키(https 전용). false 는 시작 단계에서 거부된다.
JETTAE_COOKIE_SECURE=true

# --- API 프로세스(역프록시 뒤에서 127.0.0.1 로 듣게 한다)
JETTAE_API_HOST=127.0.0.1
JETTAE_API_PORT=8000
JETTAE_MAX_UPLOAD_BYTES=20971520

# --- worker
JETTAE_WORKER_CONCURRENCY=2
JETTAE_WORKER_POLL_S=1.0
JETTAE_JOB_LEASE_S=60
JETTAE_JOB_MAX_ATTEMPTS=5

# --- 공개 자료 수집(법제처 DRF). https://open.law.go.kr 에서 받은 본인 OC.
JETTAE_DRF_OC=change-me-own-drf-oc

# --- LLM: 운영 기본은 오프라인·예산 0. 실제 호출을 켜려면 .env.live-llm.example 의 항목을 추가하고
# JETTAE_LLM_BUDGET_DB 를 PostgreSQL(보통 JETTAE_DATABASE_URL 과 같은 값)로 둔다.
JETTAE_LLM_MODE=offline
JETTAE_LLM_BUDGET_KRW=0
