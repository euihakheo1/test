# Standalone Next.js runtime. API rewrite destination is fixed at build time.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG JETTAE_API_ORIGIN=http://api:8000
ENV JETTAE_API_ORIGIN=$JETTAE_API_ORIGIN NEXT_TELEMETRY_DISABLED=1 JETTAE_NEXT_STANDALONE=1
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
