# Copy to deploy/.env and fill in real values. Never commit the real file (.env is gitignored).
# Every value below is a fake placeholder. Replace all of them; the prod startup check refuses
# the placeholder JWT secret, a placeholder database password and an http or wildcard origin
# (it cannot judge whether a password you chose is strong).
POSTGRES_PASSWORD=change-me-postgres-password
# >= 32 random bytes, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JETTAE_JWT_SECRET=change-me-generate-a-random-48-byte-secret
# exact https origin of the web UI (comma-separated for several); '*' is refused
JETTAE_ALLOWED_ORIGINS=https://app.example.com
JETTAE_API_PORT=8000
JETTAE_WORKER_CONCURRENCY=2
# paid LLM calls stay off unless both are changed (see .env.live-llm.example at the repo root)
JETTAE_LLM_MODE=offline
JETTAE_LLM_BUDGET_KRW=0
# Docker network of this compose project. The reverse proxy on the host reaches the API from
# the gateway address, which is the only proxy whose X-Forwarded-For the API trusts.
# JETTAE_COMPOSE_SUBNET=172.31.250.0/24
# JETTAE_PROXY_GATEWAY=172.31.250.1
