# Local inference only. Copy to .env.vllm (ignored), select it with JETTAE_ENV_FILE in both
# API and worker terminals. No OpenAI/Anthropic key or paid budget is needed.
JETTAE_ENV=dev
JETTAE_DATABASE_URL=sqlite:///./var/jettae.db
JETTAE_BLOB_DIR=./var/blobs
JETTAE_LLM_MODE=local
JETTAE_LLM_PROVIDER=vllm
JETTAE_VLLM_BASE_URL=http://127.0.0.1:8001/v1
JETTAE_VLLM_MODEL=Qwen3-4B-Instruct-2507-cdbee75
JETTAE_VLLM_WEIGHTS=Qwen/Qwen3-4B-Instruct-2507
JETTAE_VLLM_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
# Must match VLLM_API_KEY used by the inference server. Replace this local example.
JETTAE_VLLM_API_KEY=change-me-local-inference-key
JETTAE_LLM_BUDGET_KRW=0
JETTAE_LLM_CACHE_DIR=./var/llm_cache
# 0 = actually infer on each local run; replay is a separate mode. Cache still records calls.
JETTAE_LLM_LOCAL_CACHE=0
JETTAE_LLM_TIMEOUT_S=120
JETTAE_LLM_MAX_RETRIES=1
JETTAE_DRF_OC=test
