# 로컬 데모·개발용 백엔드 설정 (JETTAE_ENV=dev). 사용법: cp .env.example .env
#
# 읽는 규칙(백엔드 jettae 명령 전부):
#   - JETTAE_ENV_FILE 이 있으면 그 파일만 읽고, 없으면 "명령을 실행한 폴더"의 ./.env 를 읽는다.
#   - 셸에 이미 있는 환경 변수가 파일 값보다 우선한다.
#   - .env 는 .gitignore 대상이다. 실제 값이 든 파일을 커밋하지 않는다.
# 이 파일의 값은 모두 로컬 전용 예시다. 운영 설정은 .env.prod.example, 실제 LLM 실행은
# .env.live-llm.example, 무료 로컬 추론은 .env.vllm.example 을 본다.

JETTAE_ENV=dev

# SQLite 파일과 업로드 파일 저장소(저장소 루트 기준 상대 경로, var/ 는 .gitignore 대상).
JETTAE_DATABASE_URL=sqlite:///./var/jettae.db
JETTAE_BLOB_DIR=./var/blobs

# 비워 두면 dev 에서는 프로세스마다 임시 키를 만들어 API 를 다시 시작하면 로그인이 풀린다.
# 고정하려면 아래 명령으로 만든 값을 넣는다(값을 공유하거나 커밋하지 않는다):
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JETTAE_JWT_SECRET=

# 화면(Next.js) 출처. 화면은 같은 출처의 /api 를 Next rewrites 로 넘기므로 보통 비워 둬도 된다.
# 다른 출처에서 쿠키로 API 를 부를 때만 정확한 출처를 쉼표로 적는다('*' 는 거부된다).
JETTAE_ALLOWED_ORIGINS=

# LLM: 기본은 오프라인, 유료 호출 예산 0원. API 키를 여기에 넣지 않는다.
JETTAE_LLM_MODE=offline
JETTAE_LLM_BUDGET_KRW=0

# 법제처 DRF OC: 개발은 공개 샘플 키 test. 운영·대량 수집은 본인 OC(.env.prod.example).
JETTAE_DRF_OC=test
