# frontend/.env.local 로 복사해 쓴다(Next.js 는 frontend/.env.local 을 읽는다; 이 파일 자체는 읽지 않음).
# 아래 값은 모두 `next build` 때 빌드 결과에 고정된다. 바꾸면 다시 빌드해야 한다.

# rewrites 대상(백엔드 API 주소). 브라우저는 같은 출처의 /api/v1/* 만 부르고 Next 가 여기로 넘긴다.
# 인증 쿠키·CSRF 쿠키가 화면 출처에 심겨야 하므로 브라우저가 다른 출처의 API 를 직접 부르는 설정은 없다.
JETTAE_API_ORIGIN=http://127.0.0.1:8000
# 업로드 사전 검사 크기(MB). 서버 JETTAE_MAX_UPLOAD_BYTES 와 맞춘다(최종 검사는 서버가 한다).
NEXT_PUBLIC_MAX_UPLOAD_MB=20
