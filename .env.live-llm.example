# 실제(유료) LLM 실행용 설정 예시. 기본 데모·테스트·CI 에는 필요 없다.
#
# 사용법:
#   cp .env.live-llm.example .env.live-llm      # .env.* 는 .gitignore 대상
#   (아래 change-me 값과 환율·가격을 직접 채운다)
#   export JETTAE_ENV_FILE=.env.live-llm         # 이 파일만 읽게 한다(./.env 대신)
# JETTAE_ENV_FILE 은 API·worker·MCP·agent·ocr 명령이 모두 같은 값을 써야 한다.
#
# 유료 호출은 아래 네 조건이 모두 맞을 때만 일어난다:
#   1) JETTAE_LLM_MODE=live  2) JETTAE_LLM_BUDGET_KRW > 0
#   3) 비용 환산: JETTAE_LLM_KRW_PER_USD(내장 가격표가 있는 Anthropic 모델) 또는 JETTAE_LLM_PRICES
#   4) 회사 자료를 보내는 호출은 그 회사가 JETTAE_TENANT_SETTINGS 파일에서 allow_external_llm=true
# 어느 하나라도 빠지면 호출하지 않고 거부(refused)나 설정 오류로 끝난다.

JETTAE_ENV=dev
JETTAE_DATABASE_URL=sqlite:///./var/jettae.db
JETTAE_BLOB_DIR=./var/blobs

# --- 공급자와 모델
JETTAE_LLM_MODE=live
# anthropic 또는 openai
JETTAE_LLM_PROVIDER=anthropic
# anthropic 모델 id(비우면 코드 기본값). openai 는 JETTAE_OPENAI_MODEL 이 필수.
JETTAE_LLM_MODEL=
JETTAE_OPENAI_MODEL=
# 공급자 SDK 가 읽는 키. 쓰는 공급자 것만 채운다. 이 파일을 커밋하거나 공유하지 않는다.
ANTHROPIC_API_KEY=change-me-anthropic-key
OPENAI_API_KEY=change-me-openai-key

# --- 예산(원). 원장 전체의 누적 상한이며 실행마다 초기화되지 않는다.
JETTAE_LLM_BUDGET_KRW=5000
# 원/달러 환율. 코드는 환율을 가정하지 않는다. 오늘 쓸 값을 직접 넣는다(예시 값 아님).
JETTAE_LLM_KRW_PER_USD=change-me-krw-per-usd
# 내장 가격표가 없는 모델(OpenAI 전부 포함)은 원 단위 가격을 JSON 으로 직접 준다. 예:
# JETTAE_LLM_PRICES={"<모델 id>": {"input_krw_per_mtok": "<원>", "output_krw_per_mtok": "<원>"}}
JETTAE_LLM_PRICES=
# 가격을 모르는 모델을 허용하려면 1 (비용이 null 로 기록된다). 기본은 거부.
JETTAE_LLM_ALLOW_UNKNOWN_PRICE=0

# --- 공유 예산 저장소
# 여러 프로세스(API, worker 여러 개)가 한 한도를 나눠 쓰게 한다. 서비스 DB 와 같은 URL 을 쓰면
# 마이그레이션 0004 의 llm_budget 테이블에 예약한다. 운영(prod)에서는 PostgreSQL 이 필수.
JETTAE_LLM_BUDGET_DB=sqlite:///./var/jettae.db
JETTAE_LLM_BUDGET_ID=default
JETTAE_LLM_RESERVATION_TTL_S=900
# JETTAE_LLM_BUDGET_DB 를 비우면 파일 원장을 쓴다. 이때 경로는 반드시 절대 경로:
# JETTAE_LLM_LEDGER=/절대/경로/llm_budget.jsonl

# --- 회사별 외부 LLM 동의(파일 경로). 파일 내용 예: {"tn_...": {"allow_external_llm": true}}
# 회사 id 는 로그인 후 GET /api/v1/auth/me 의 tenant.id. 파일이 없으면 모든 회사가 거부된다.
JETTAE_TENANT_SETTINGS=./var/tenant_settings.json

# --- 호출 제어
JETTAE_LLM_CACHE_DIR=./var/llm_cache
JETTAE_LLM_TIMEOUT_S=120
JETTAE_LLM_MAX_RETRIES=2

# 스캔 PDF 를 VLM 으로 읽게 하려면 vlm (위 예산·동의 규칙이 그대로 적용된다). 비우면 사용 안 함.
JETTAE_OCR_PROVIDER=
